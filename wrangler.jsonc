{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "percussion-sync",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "percussion-sync",
    "database_id": "af34db59-ccde-4495-bd51-de59d9a538fb",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "LOGIN_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 5, "period": 60 }
  }]
}
